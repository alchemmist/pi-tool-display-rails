{
  "name": "pi-tool-display-rails",
  "version": "1.3.2-rails.1",
  "description": "Compact Pi tool display with minimal colored rails for user messages",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-tui",
    "tool-rendering",
    "tool-output",
    "diff-visualization",
    "output-truncation",
    "compact",
    "diff"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@actitude.cl",
    "url": "https://actitud.xyz"
  },
  "contributors": [
    {
      "name": "MasuRii",
      "url": "https://github.com/MasuRii"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstebanForge/pi-extensions.git",
    "directory": "packages/pi-tool-display"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./extensions/index.ts",
    "./tool-display-api-consumer": {
      "types": "./lib/tool-display-api-consumer.d.ts",
      "default": "./lib/tool-display-api-consumer.js"
    }
  },
  "files": [
    "extensions",
    "lib",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@estebanforge/pi-tui-dialogs": "^0.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
